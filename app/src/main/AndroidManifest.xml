<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗权限：没有它就不能把桌宠画到别的应用上面 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务权限（Android 9+ 必需） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14（targetSdk 34）要求声明前台服务的具体类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 显示通知需要运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 调用 DeepSeek 聊天接口需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 截屏（MediaProjection）需要的前台服务类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        读取「前台应用包名」，用于知道你在玩什么/看什么。
        只读包名，不截屏、不读内容；属于特殊权限，必须用户去系统设置里手动开启。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BaiYunPet">

        <!-- 主界面：负责申请权限、启动/关闭桌宠 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：填 API Key、云朵大小、气泡透明度 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!--
            桌宠服务：
            - exported=false：只允许本应用启动
            - foregroundServiceType=specialUse：桌宠属于「特殊用途」前台服务，
              这是 Android 14 上不崩溃的关键，Play 商店上架时需要填写用途说明
        -->
        <service
            android:name=".FloatingPetService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_pet_overlay" />
        </service>

        <!--
            无障碍服务：只读界面文字（跳过输入框）。
            由系统绑定，必须导出 + 用 BIND_ACCESSIBILITY_SERVICE 保护。
        -->
        <service
            android:name=".BaiyunAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilityservice" />
        </service>

        <!-- 开机 / 应用更新后自动把桌宠服务拉起来 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
