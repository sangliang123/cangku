<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页：ScrollView + 一层 LinearLayout，够用就好。
    包含 API Key、测试连接、云朵大小、气泡不透明度、保存。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <!-- ============ API Key ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/settings_api_key"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- inputType=textPassword：输入内容显示成 ●●●● -->
        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_settings_input"
            android:hint="@string/settings_api_key_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_api_key_tip"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/settings_test"
            app:cornerRadius="14dp" />

        <!-- ============ 云朵大小 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_cloud_size"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCloudSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mint_700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- max=60：progress 0~60 对应 60~120dp -->
        <SeekBar
            android:id="@+id/seekCloudSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="60"
            android:progressTint="@color/mint_700"
            android:thumbTint="@color/mint_700" />

        <!-- ============ 气泡不透明度 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_bubble_alpha"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBubbleAlphaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mint_700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- max=50：progress 0~50 对应 50%~100% -->
        <SeekBar
            android:id="@+id/seekBubbleAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="50"
            android:progressTint="@color/mint_700"
            android:thumbTint="@color/mint_700" />

        <!-- 拖动时实时预览气泡透明度 -->
        <TextView
            android:id="@+id/viewBubblePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chat_bubble"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="@string/settings_preview"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- ============ 保存 ============ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="@string/settings_save"
            android:textSize="16sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
