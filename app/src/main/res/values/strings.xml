    <!-- 截屏感知 -->
    <string name="capture_section_title">截屏感知（可选）</string>
    <string name="capture_switch">白云看屏幕</string>
    <string name="capture_switch_desc">只在你打游戏 / 看小说时截屏，用来识别画面里的文字</string>
