    <!-- 厂商白名单引导 -->
    <string name="whitelist_title">让白云在 %1$s 上活下来</string>
    <string name="whitelist_message">%1$s\n\n系统可能随时清掉后台的桌宠。开了自启动 / 后台运行，就不用反复叫她出来。</string>
    <string name="whitelist_steps_xiaomi">小米 / Redmi：设置 → 应用设置 → 授权管理 → 自启动，给白云打勾；再到电池里把「后台限制」设为无限制。</string>
    <string name="whitelist_steps_huawei">华为 / 荣耀：设置 → 应用 → 应用启动管理 → 白云 → 关掉「自动管理」，手动允许自启动和后台活动。</string>
    <string name="whitelist_steps_oppo">OPPO / 一加 / realme：设置 → 电池 → 应用耗电管理 → 白云 → 允许后台运行。</string>
    <string name="whitelist_steps_vivo">vivo / iQOO：设置 → 电池 → 后台耗电管理 → 白云 → 允许后台高耗电。</string>
    <string name="whitelist_steps_samsung">三星：设置 → 电池 → 后台使用限制 → 白云 → 加入「永不休眠的应用」。</string>
    <string name="whitelist_go">去设置</string>
    <string name="whitelist_later">知道了</string>
