    <!-- 屏幕侦测（使用情况访问） -->
    <string name="usage_title">让白云知道你在玩什么</string>
    <string name="usage_message">打开「使用情况访问」后，白云才能知道你切到了哪个 App，好在打游戏时吐槽你、看小说时催你睡觉。\n\n她只读取前台应用的包名，不截屏、不读聊天、不读任何内容。\n\n设置 → 使用情况访问 → 白云 → 打开。</string>
    <string name="usage_go">去开启</string>
    <string name="usage_later">以后再说</string>
